DATABASE_URL=postgresql+psycopg://rad:change-me@127.0.0.1:5432/rad
DATA_DIR=.
CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
ENVIRONMENT=development
# Development tool only. Never exposed to Vite or committed.
API_KEY_21ST=

# Docker Compose only; choose a private URL-safe password.
POSTGRES_PASSWORD=replace-with-private-local-password

# Optional converted list-price reference. Toman per USD (not rial).
# Both are required; timestamp must have a timezone and cannot be in the future.
# REFERENCE_USD_TOMAN=
# REFERENCE_RATE_AT=

# Independent presentation switches (restart Vite/rebuild after changing).
VITE_ENABLE_DEPTH=true
VITE_ENABLE_SCROLL_SHOWCASE=true
VITE_ENABLE_3D_INTRO=true
